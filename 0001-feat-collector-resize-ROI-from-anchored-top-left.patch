 type HostClient = { left: number; top: number; width: number; height: number };
 
 function CaptureLibraryDrawer({
@@ -296,11 +299,19 @@ export function StepCaptureSamples({
   }
 
   function onPointerDown(e: React.PointerEvent) {
-    if (locked || !frozen || !shot) return;
+    if (locked || !frozen || !shot || roi) return;
     e.currentTarget.setPointerCapture(e.pointerId);
     const p = pointerPos(e);
     setRoi(undefined);
-    setDrag({ startX: p.x, startY: p.y, currentX: p.x, currentY: p.y });
+    setDrag({ kind: "select", startX: p.x, startY: p.y, currentX: p.x, currentY: p.y });
+  }
+
+  function startResize(e: React.PointerEvent, edge: "right" | "bottom" | "corner") {
+    e.stopPropagation();
+    if (locked || !roi || !shot) return;
+    surfaceRef.current?.setPointerCapture(e.pointerId);
+    const p = pointerPos(e);
+    setDrag({ kind: "resize", edge, original: roi, currentX: p.x, currentY: p.y });
   }
 
   function onPointerMove(e: React.PointerEvent) {
@@ -311,7 +322,9 @@ export function StepCaptureSamples({
 
   function onPointerUp() {
     if (!drag || !shot) return;
-    const next = dragToCaptureRoi(drag.startX, drag.startY, drag.currentX, drag.currentY);
+    const next = drag.kind === "resize"
+      ? resizeCaptureRoi(drag.original, drag.edge, drag.currentX, drag.currentY, shot.width, shot.height)
+      : dragToCaptureRoi(drag.startX, drag.startY, drag.currentX, drag.currentY);
     setDrag(undefined);
     setRoi(next ?? undefined);
   }
@@ -355,12 +368,14 @@ export function StepCaptureSamples({
   }
 
   const liveRoi = drag
-    ? {
+    ? drag.kind === "resize" && shot
+      ? resizeCaptureRoi(drag.original, drag.edge, drag.currentX, drag.currentY, shot.width, shot.height)
+      : drag.kind === "select" ? {
         x: Math.min(drag.startX, drag.currentX),
         y: Math.min(drag.startY, drag.currentY),
         width: Math.abs(drag.currentX - drag.startX),
         height: Math.abs(drag.currentY - drag.startY),
-      }
+      } : roi
     : roi;
 
   if (!electron) {
@@ -465,6 +480,11 @@ export function StepCaptureSamples({
                   ? `ROI ${roi.width}×${roi.height} at ${roi.x},${roi.y}`
                   : "Drag on the frozen frame to select a region"}
               </small>
+              {roi && (
+                <button type="button" disabled={locked || busy} onClick={() => { setRoi(undefined); setDrag(undefined); }}>
+                  Reset ROI
+                </button>
+              )}
               <button
                 type="button"
                 className="primary"
@@ -531,7 +551,26 @@ export function StepCaptureSamples({
                 width: (liveRoi.width / shot.width) * imageBox.width,
                 height: (liveRoi.height / shot.height) * imageBox.height,
               }}
-            />
+            >
+              {roi && !locked && (["right", "bottom", "corner"] as const).map((edge) => (
+                <span
+                  key={edge}
+                  className={`collector-roi-resize-handle collector-roi-resize-${edge}`}
+                  role="button"
+                  tabIndex={0}
+                  aria-label={`Resize ROI ${edge} edge`}
+                  onPointerDown={(e) => startResize(e, edge)}
+                  onKeyDown={(e) => {
+                    if (!roi || !shot || !["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.key)) return;
+                    e.preventDefault();
+                    const delta = e.shiftKey ? 10 : 1;
+                    const dx = e.key === "ArrowRight" ? delta : e.key === "ArrowLeft" ? -delta : 0;
+                    const dy = e.key === "ArrowDown" ? delta : e.key === "ArrowUp" ? -delta : 0;
+                    setRoi(resizeCaptureRoi(roi, edge, roi.x + roi.width + dx, roi.y + roi.height + dy, shot.width, shot.height));
+                  }}
+                />
+              ))}
+            </div>
           )}
         </div>
       )}
